# Copiez ce fichier en .env et reportez les MÊMES valeurs que dans
# alerte_secours_web/.env — Cim'Log lit le même projet Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Annuaire des personnels — projet Supabase tiers, lu en direct (jamais
# recopié). Mêmes valeurs que alerte_secours_web/.env.
VITE_ANNUAIRE_URL=
VITE_ANNUAIRE_ANON_KEY=

# Clé IGN Géoplateforme — nécessaire uniquement pour le SCAN25 (couche
# protégée). Même valeur que alerte_secours_web/.env.
VITE_IGN_API_KEY=
